# Copy to .env and adjust. Every Python entry point reads this file.
# The defaults match the docker compose service.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=recsys
DB_USER=recsys
DB_PASSWORD=recsys

# Data generation. The seed is what makes the dataset reproducible; every
# number quoted in the README came from this value.
GEN_SEED=20260912
GEN_USERS=10000
GEN_PRODUCTS=2000
GEN_HISTORY_DAYS=540
GEN_END_DATE=2026-09-01

# Offline evaluation. EVAL_TRAIN_FRACTION is the share of the interaction
# timeline treated as history; the rest is held out as the future.
EVAL_TRAIN_FRACTION=0.80
EVAL_USERS=1500

# API
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
